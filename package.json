{
  "name": "ade",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --import tsx --test",
    "dev": "tsx src/spike.ts",
    "review": "tsx src/review-spike.ts",
    "ade": "tsx src/cli.ts",
    "desktop:dev": "npm run desktop:sidecar:build && npm --prefix desktop run dev",
    "desktop:build": "npm run desktop:sidecar:build && npm --prefix desktop run tauri build",
    "desktop:test": "npm test",
    "desktop:package": "npm run desktop:sidecar:build && npm --prefix desktop run tauri build",
    "desktop:package:app": "npm run desktop:sidecar:build && npm --prefix desktop run tauri build -- --bundles app",
    "desktop:release": "node scripts/package-desktop-release.mjs",
    "desktop:smoke": "node scripts/smoke-desktop-bundle.mjs",
    "desktop:sidecar": "tsx src/desktop-sidecar.ts",
    "desktop:sidecar:build": "node scripts/build-desktop-sidecar.mjs",
    "seed:check": "node scripts/sync-seed-plugin.mjs --check",
    "seed:sync": "node scripts/sync-seed-plugin.mjs --sync"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@usebruno/filestore": "^0.12.0",
    "@usebruno/lang": "^0.39.0",
    "axios": "^1.20.0",
    "cross-spawn": "^7.0.6",
    "nanoid": "^3.3.19"
  }
}
