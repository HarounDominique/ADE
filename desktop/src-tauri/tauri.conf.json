{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assay",
  "version": "0.1.0",
  "identifier": "com.ade.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Assay",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Local-first workstation for agentic software engineering",
    "longDescription": "Assay keeps Projects, Tasks, agents, code, terminal, Git, verification and review in one local-first development workspace.",
    "homepage": "https://github.com/HarounDominique/ADE",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "resources": {
      "../sidecar-dist": "sidecar-dist",
      "../../plugins/seed": "seed"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ]
      }
    }
  }
}
